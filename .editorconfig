# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab
indent_size = 4
tab_width = 4

# Golden-file fixtures are byte-exact conversion output. An editor appending a
# final newline or trimming trailing whitespace silently breaks them.
[src/__fixtures__/**]
insert_final_newline = false
trim_trailing_whitespace = false
